############################################
# Build artifacts (CMake)
############################################
build/
build-*/
cmake-build-*/
out/
bin/
lib/

CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
compile_commands.json

############################################
# CMake presets (user / local)
############################################
CMakeUserPresets.json
CMakePresets.json

############################################
# CTest scratch output
############################################
Testing/

############################################
# Compiled objects / binaries
############################################
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

############################################
# Debug / profiling
############################################
*.tmp
*.prof
*.gprof
vgcore.*
core
core.*

############################################
# IDE / Editor files
############################################
# Machine-specific (compiler paths, IntelliSense config); each developer keeps
# their own, as is conventional for open-source C++ solvers.
.vscode/
.idea/
.claude/
*.swp
*.swo
*.user
*.user.*
*.vcxproj*
*.sln

############################################
# OS junk
############################################
.DS_Store
Thumbs.db

############################################
# Python (bindings, generators, benchmarks)
############################################
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
.env
# pybind11 module built in place by python/CMakeLists.txt
python/ksp_qp_bind*.so

############################################
# Benchmark output (CSVs, performance profiles)
#
# Regenerate with python/benchmark_*.py or the C++ drivers' --name all sweeps.
# Note that data/ is deliberately NOT ignored: the Maros-Meszaros and Netlib
# instances are tracked so benchmarks are reproducible from a fresh clone.
############################################
results/

############################################
# LaTeX / notes
############################################
*.aux
*.log
*.toc
*.out
*.synctex.gz
